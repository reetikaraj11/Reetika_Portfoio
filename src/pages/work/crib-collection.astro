<script>
  document.querySelectorAll<HTMLElement>("[data-mat]").forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>("button[data-r]")];
    btns.forEach((b) => b.addEventListener("click", () => {
      const r = b.dataset.r;
      btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      root.querySelectorAll<HTMLElement>(".ring").forEach((x) => x.classList.toggle("on", x.dataset.r === r));
      root.querySelectorAll<HTMLElement>(".mat-what").forEach((x) => (x.hidden = x.dataset.r !== r));
    }));
  });
</script>

