<Chapter id="costing" num="14" title="Costing: line by line, against a $150 limit" lede="Each product was costed against the brief's limit for the whole collection. Figures are in Indian rupees, from her costing sheets." tone="white">
  <div class="grid g2 reveal">
    {costs.map((c) => {
      const max = Math.max(...c.rows.map((r) => r[1] as number));
      return (
        <div class="card ink cost">
          <div class="cost-h"><h3>{c.t}</h3><span>Total <b>{fmt(c.total)}</b></span></div>
          <ul>{c.rows.map(([k, v]) => <li><span>{k}</span><i style={`width:${((v as number) / max) * 100}%`}></i><b>{fmt(v as number)}</b></li>)}</ul>
          <p class="muted small" style="margin:10px 0 0">{c.note}</p>
        </div>
      );
    })}
  </div>
</Chapter>

