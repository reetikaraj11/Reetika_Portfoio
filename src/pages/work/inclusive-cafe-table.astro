    <div class="protos">
      <Fig src={img("proto-column")} alt="Physical prototype: aluminium column standing on a yellow suction-cup base" ratio="3/4" hand="suction base prototype" />
      <Fig src={img("proto-suction")} alt="Close-up of the suction cups gripping a smooth floor tile" ratio="3/4" />
      <Fig src={img("proto-steps-cardboard")} alt="Cardboard model of the Steps Table with tops at different heights" ratio="3/4" hand="Steps Table mock-up" />
