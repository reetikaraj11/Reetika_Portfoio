---
import Base from "../layouts/Base.astro";
import IdCard from "../components/IdCard.astro";
import RollingWork from "../components/RollingWork.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const projects = [
  {
    href: "/work/inclusive-cafe-table", title: "A Table for Everyone",
    blurb: "Four quarters, four heights: a café table that a child, a wheelchair user and a tall adult can share.",
    tags: ["Habitat study", "TRIZ", "FEA"], img: "/work/habitat/pizza-exploded.webp", imgBg: "#000000", tone: "lav",
  },
  {
    href: "/work/crib-collection", title: "Beneath the Water, Into the Snow",
    blurb: "A 13-piece mermaid crib collection and a penguin play gym, designed from print to prototype within a $150 cost limit.",
    tags: ["Design collection", "Illustration", "Textiles"], img: "/work/crib/hero-crib.webp", imgBg: "#F3EEF2", tone: "pink",
  },
  {
    href: "/work/aasan", title: "Aasan",
    blurb: "A study chair with a fold-over desk, knee and foot support, and open armrests for sitting cross-legged.",
    tags: ["Anthropometry", "Survey", "Prototype"], img: "/work/aasan/chair-cutout.webp", imgBg: "radial-gradient(120% 95% at 50% 38%, #FFFFFF 0%, #EDEAFA 52%, #F5E7B8 100%)", tone: "sky",
  },
  {
    href: "/work/posture-buddy", title: "Posture Buddy",
    blurb: "A desk friend that notices slouching and fatigue, and nudges you back with gentle reminders.",
    tags: ["Personas", "Usability testing", "AI"], img: "/work/posture-buddy/cover.webp", imgBg: "#FDE9C7", tone: "lemon",
  },
];
---
<Base title="Reetika Raj · Product Design, Development & Management" theme="home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="intro">
        <span class="sticker lav">Hello!</span>
        <h1>I'm Reetika.</h1>
        <p class="lede">Creative product designer with two years in industry, now doing my M.Des in Product Design, Development and Management at IISc Bengaluru. I like to begin with people, understanding how they live and then designing everyday products around their needs. I enjoy bringing research, design and strategy together, so a good idea can become a real product.</p>
        <div class="cta-row">
          <a class="btn primary" href="#work">Scroll down to see my work ↓</a>
          <a class="btn" href={`${base}/Reetika_Raj_CV.pdf`}>Download CV</a>
        </div>
      </div>
      <div class="badge-col"><IdCard /></div>
    </div>
  </section>

  <section id="work" class="work">
    <div class="wrap work-head">
      <h2>Work</h2>
    </div>
    <RollingWork projects={projects} />
  </section>

  <section id="about" class="about">
    <div class="wrap narrow">
      <h2>About me</h2>
      <p class="lede">I started my design journey with a B.Des in Textile Design at NIFT Delhi, followed by two years in industry designing seasonal home and kids' collections for international buyers. There, I worked across the full development cycle, from researching markets and trends to seeing each collection through to the final product. Most recently, I had the chance to research caregiver burnout at A Super Hero, an autism-awareness platform, and I'm now continuing to learn through my M.Des at IISc Bengaluru.</p>
      <p class="lede">Working closely with buyers taught me a lesson I still carry with me: good design also has to arrive on time, stay within budget and work for the business. It made me curious about the bigger picture: who a product is for, why it should exist, and how it finally gets made. That curiosity is what drew me towards product management, design, and research.</p>
      <p class="lede">Away from the desk, you'll usually find me travelling, trekking up a hill, photographing nature, spending time with my loved ones, or listening to music with coffee on the side.</p>
      <a class="btn primary" href={`${base}/Reetika_Raj_CV.pdf`}>Download CV</a>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 0; }
  .hero-grid { display: grid; gap: 8px; align-items: center; min-height: calc(100svh - 67px); }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.05fr .95fr; } }
  .intro { padding: 32px 0; }
  .intro .sticker { margin-bottom: 18px; background: transparent; }
  .intro h1 { font-size: clamp(3.4rem, 8.4vw, 6.6rem); line-height: .98; letter-spacing: -0.025em; margin-bottom: .35em; }
  .hl { background: linear-gradient(transparent 60%, var(--lemon) 60%, var(--lemon) 92%, transparent 92%); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .badge-col { align-self: stretch; height: min(640px, calc(100svh - 67px)); }
  @media (max-width: 899px) { .hero-grid { min-height: 0; } .badge-col { order: -1; height: 520px; } .intro { padding-top: 0; } }
  .work { padding: 72px 0 40px; }
  .work-head { margin-bottom: 8px; }
  .about { padding: 40px 0 96px; }
</style>
