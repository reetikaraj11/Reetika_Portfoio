---
/*
  Project cards that roll gently on a drum as you scroll. Each card's tilt, scale and
  opacity follow its distance from the middle of the screen, eased every frame so the
  motion stays smooth even with jumpy scroll wheels. The image drifts slightly inside
  its frame for a soft parallax. Static when the visitor prefers reduced motion.
*/
interface Project { href?: string; title: string; blurb: string; tags: string[]; img: string; imgBg: string; tone: string; }
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div class="drum" data-drum>
  {projects.map((p) => {
    const Tag = p.href ? "a" : "div";
    return (
      <article class="roll" data-roll>
        <Tag class:list={["rc", `tone-${p.tone}`, { soon: !p.href }]} href={p.href ? `${base}${p.href}` : undefined}>
          <div class="rc-text">
            <h3>{p.title}</h3>
            <p class="blurb">{p.blurb}</p>
            <div class="tags">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </div>
          <div class="rc-img" style={`background:${p.imgBg}`}>
            <img src={`${base}${p.img}`} alt="" loading="lazy" decoding="async" />
            {p.href && <span class="rc-go" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18"><path d="M5 13 13 5M6.5 5H13v6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>}
          </div>
        </Tag>
      </article>
    );
  })}
</div>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-drum]").forEach((drum) => {
    if (reduce) return;
    const items = [...drum.querySelectorAll<HTMLElement>("[data-roll]")].map((el) => ({
      el, card: el.firstElementChild as HTMLElement, img: el.querySelector<HTMLElement>(".rc-img img"), cur: 0, target: 0,
    }));
    const measure = () => {
      const vh = innerHeight;
      for (const it of items) {
        const r = it.el.getBoundingClientRect();
        it.target = Math.max(-1, Math.min(1, (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2)));
      }
    };
    const paint = (it: (typeof items)[number]) => {
      const d = it.cur, a = Math.abs(d), e = a * a * (3 - 2 * a); // smoothstep: flat in the middle, tilts near the edges
      it.card.style.transform = `translate3d(0, ${(d * 24).toFixed(2)}px, 0) rotateX(${(-Math.sign(d) * e * 16).toFixed(2)}deg) scale(${(1 - e * 0.06).toFixed(4)})`;
      it.card.style.opacity = (1 - e * 0.28).toFixed(3);
      if (it.img) it.img.style.transform = `translate3d(0, ${(d * -18).toFixed(2)}px, 0) scale(1.06)`;
    };
    let raf = 0;
    const tick = () => {
      let moving = false;
      for (const it of items) {
        const diff = it.target - it.cur;
        if (Math.abs(diff) > 0.0005) { it.cur += diff * 0.14; moving = true; } else it.cur = it.target;
        paint(it);
      }
      raf = moving ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { measure(); if (!raf) raf = requestAnimationFrame(tick); };
    addEventListener("scroll", kick, { passive: true });
    addEventListener("resize", kick);
    measure(); items.forEach((it) => { it.cur = it.target; paint(it); });
  });
</script>

<style>
  .drum { display: grid; gap: clamp(36px, 7vh, 80px); padding: 4vh 0 10vh; }
  .roll { perspective: 1800px; max-width: 1080px; width: 100%; margin: 0 auto; padding: 0 16px; }
  .rc { display: grid; text-decoration: none; color: var(--ink); border-radius: 32px; overflow: hidden; border: 1.5px solid var(--edge); box-shadow: 0 30px 60px -32px rgba(60, 50, 100, .32); will-change: transform, opacity; backface-visibility: hidden; transform-origin: 50% 50%; transition: box-shadow .4s ease, border-color .4s ease; }
  @media (min-width: 820px) { .rc { grid-template-columns: 0.95fr 1.05fr; min-height: 440px; } }
  a.rc:hover, a.rc:focus-visible { box-shadow: 0 40px 70px -30px rgba(60, 50, 100, .42); border-color: var(--ink); }
  .rc-text { padding: clamp(24px, 4vw, 48px); display: flex; flex-direction: column; gap: 14px; justify-content: center; }
  .rc h3 { margin: 0; font: 400 clamp(2rem, 4vw, 3.1rem)/1.05 var(--f-display); letter-spacing: -0.012em; }
  .blurb { margin: 0; color: var(--muted); max-width: 30em; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags .chip { background: var(--surface); }
  .rc-img { position: relative; min-height: 260px; overflow: hidden; }
  .rc-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 22px; will-change: transform; transition: scale .6s cubic-bezier(.2, .7, .2, 1); }
  a.rc:hover .rc-img img { scale: 1.03; }
  .rc-go { position: absolute; right: 18px; bottom: 18px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); color: var(--ink); border: 1.5px solid var(--edge); opacity: 0; transform: translateY(6px) scale(.9); transition: opacity .3s ease, transform .35s cubic-bezier(.2, .7, .2, 1); }
  a.rc:hover .rc-go, a.rc:focus-visible .rc-go { opacity: 1; transform: none; }
  @media (hover: none) { .rc-go { opacity: 1; transform: none; } }
  .soon { cursor: url("/cursor.svg") 4 4, default; }
  @media (max-width: 819px) { .rc-img { order: -1; aspect-ratio: 4 / 3; } }
</style>
