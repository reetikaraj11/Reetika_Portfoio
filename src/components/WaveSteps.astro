---
/*
  Wave-ribbon process diagram: a ribbon of alternating up/down half-circles, each half
  split into two coloured quarters, one per step. Labels sit above the upper arcs and
  below the lower ones. Below 860px it becomes a coloured vertical list.
*/
interface Step { title: string; out: string; }
interface Props { steps: Step[]; }
const { steps } = Astro.props;
const rc = 88, t = 42, pad = 24, cy = 150;
const arcs = Math.ceil(steps.length / 2);
const W = arcs * 2 * rc + pad * 2, H = 300;
const colors = ["var(--sky)", "var(--mint)", "var(--lemon)", "var(--pink)", "#F5C9A8"];
const R = rc + t / 2, r = rc - t / 2;
const P = (cx: number, rad: number, a: number) => [cx + rad * Math.cos(a), cy - rad * Math.sin(a)];
const seg = (cx: number, a0: number, a1: number) => {
  const [x0, y0] = P(cx, R, a0), [x1, y1] = P(cx, R, a1), [x2, y2] = P(cx, r, a1), [x3, y3] = P(cx, r, a0);
  const sweep = a1 < a0 ? 1 : 0;
  return `M${x0.toFixed(1)} ${y0.toFixed(1)} A${R} ${R} 0 0 ${sweep} ${x1.toFixed(1)} ${y1.toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)} A${r} ${r} 0 0 ${1 - sweep} ${x3.toFixed(1)} ${y3.toFixed(1)} Z`;
};
const items = steps.map((s, i) => {
  const k = Math.floor(i / 2), up = k % 2 === 0, cx = pad + rc + k * 2 * rc, first = i % 2 === 0;
  // upper arc runs 180°→0° (left to right over the top); lower arc runs 180°→360°
  const a0 = up ? (first ? Math.PI : Math.PI / 2) : (first ? Math.PI : 1.5 * Math.PI);
  const a1 = up ? (first ? Math.PI / 2 : 0) : (first ? 1.5 * Math.PI : 2 * Math.PI);
  const am = (a0 + a1) / 2;
  const [nx, ny] = P(cx, rc, am), [lx] = P(cx, R + 6, am);
  return { ...s, n: i + 1, up, d: seg(cx, a0, a1), color: colors[i % colors.length], nx, ny, lx };
});
---
<div class="ws reveal">
  <div class="ws-fig" style={`aspect-ratio:${W}/${H}`}>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      {items.map((it) => (
        <g>
          <path d={it.d} fill={it.color} />
          <text x={it.nx} y={it.ny + 5} text-anchor="middle">{String(it.n).padStart(2, "0")}</text>
        </g>
      ))}
    </svg>
    {items.map((it) => (
      <div class:list={["ws-label", it.up ? "up" : "down"]} style={`left:${(it.lx / W) * 100}%`}>
        <span class="ws-k">Step {String(it.n).padStart(2, "0")}</span>
        <b>{it.title}</b>
        <small>{it.out}</small>
      </div>
    ))}
  </div>
  <ol class="ws-list">
    {items.map((it) => (
      <li style={`--c:${it.color}`}><span class="ws-n">{String(it.n).padStart(2, "0")}</span><div><b>{it.title}</b><small>Output: {it.out}</small></div></li>
    ))}
  </ol>
</div>

<style>
  .ws-fig { position: relative; margin: 150px 0 150px; }
  .ws-fig svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ws-fig path { stroke: var(--surface); stroke-width: 2; }
  .ws-fig text { font: 400 20px var(--f-display); fill: var(--ink); }
  .ws-label { position: absolute; width: 132px; transform: translateX(-50%); text-align: center; line-height: 1.25; }
  .ws-label.up { bottom: calc(100% - 18px); }
  .ws-label.down { top: calc(100% - 18px); }
  .ws-label::after { content: ""; position: absolute; left: 50%; width: 1px; height: 26px; background: var(--edge); opacity: .6; }
  .ws-label.up::after { top: 100%; } .ws-label.down::after { bottom: 100%; }
  .ws-label.up { padding-bottom: 30px; } .ws-label.down { padding-top: 30px; }
  .ws-k { display: block; font-size: .72rem; font-weight: 800; color: var(--accent-ink); }
  .ws-label b { display: block; font-size: .86rem; }
  .ws-label small { display: block; color: var(--muted); font-size: .74rem; margin-top: 2px; }
  .ws-list { display: none; list-style: none; margin: 0; padding: 0; gap: 10px; }
  .ws-list li { display: flex; gap: 12px; align-items: flex-start; padding: 10px 12px; border-radius: var(--radius-sm); background: var(--surface); border-left: 6px solid var(--c); }
  .ws-n { font: 400 1.2rem/1.1 var(--f-display); color: var(--accent-ink); min-width: 1.6em; }
  .ws-list b { display: block; } .ws-list small { color: var(--muted); }
  @media (max-width: 1000px) { .ws-label { width: 104px; } .ws-label small { display: none; } }
  @media (max-width: 860px) { .ws-fig { display: none; } .ws-list { display: grid; } }
</style>
