---
/* Before/after drag slider for two images with the same framing. */
interface Props { before: string; after: string; beforeLabel: string; afterLabel: string; alt: string; ratio?: string; }
const { before, after, beforeLabel, afterLabel, alt, ratio = "1400/990" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div class="compare" style={`aspect-ratio:${ratio}`} data-compare>
  <img src={`${base}${after}`} alt={`After: ${alt}`} loading="lazy" />
  <div class="top" style="--pos:50%"><img src={`${base}${before}`} alt={`Before: ${alt}`} loading="lazy" /></div>
  <span class="tag l sticker pink">{beforeLabel}</span>
  <span class="tag r sticker mint">{afterLabel}</span>
  <span class="handle" style="--pos:50%" aria-hidden="true"><span>⇆</span></span>
  <input type="range" min="0" max="100" value="50" aria-label={`Drag to compare ${beforeLabel} and ${afterLabel}`} />
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((el) => {
    const input = el.querySelector("input")!;
    const set = () => el.querySelectorAll<HTMLElement>(".top, .handle").forEach((n) => n.style.setProperty("--pos", input.value + "%"));
    input.addEventListener("input", set); set();
  });
</script>
<style>
  .compare { position: relative; border-radius: var(--radius); overflow: hidden; border: 1.5px solid var(--edge); background: #fff; user-select: none; }
  .compare img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .top { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); background: #fff; }
  .tag { position: absolute; top: 12px; z-index: 2; }
  .tag.l { left: 12px; } .tag.r { right: 12px; }
  .handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; background: var(--edge); transform: translateX(-50%); pointer-events: none; z-index: 2; }
  .handle span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 44px; height: 44px; border-radius: 50%; background: var(--lemon); border: 1.5px solid var(--edge); display: grid; place-items: center; font-weight: 800; }
  input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: url("/cursor-link.svg") 4 4, ew-resize; z-index: 3; margin: 0; }
  input:focus-visible + * { outline: none; }
  .compare:has(input:focus-visible) { outline: 3px solid var(--accent-ink); outline-offset: 3px; }
</style>
