---
/*
  Hanging ID card on a lanyard. The strap is a verlet rope; the card is a rigid stick
  hung from the rope's last point. Drag/fling with mouse or touch. Static when the
  visitor prefers reduced motion.
  Photo: drop a file at site/public/reetika.jpg (or .webp / .png) and it appears automatically.
*/
import fs from "node:fs";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const photoFile = ["reetika.jpg", "reetika.webp", "reetika.png"].find((f) =>
  fs.existsSync(new URL(`../../public/${f}`, import.meta.url))
);
---
<div class="stage" data-badge>
  <svg class="strap" aria-hidden="true"><path class="s-edge" /><path class="s-fill" /><path class="s-band b1" /><path class="s-band b2" /><path class="s-band b3" /><path class="s-band b4" /><path class="s-band b5" /><path class="s-dash" /></svg>
  <div class="badge" role="group" aria-label="ID card for Reetika Raj, Product Design, Development and Management">
    <div class="clip" aria-hidden="true"><span></span></div>
    <div class="sleeve">
      <div class="slot" aria-hidden="true"></div>
      <div class="card">
        <div class="card-top">
          <img class="logo-iisc" src={`${base}/logo-iisc.png`} alt="Indian Institute of Science" draggable="false" />
          <img class="logo-cpdm" src={`${base}/logo-cpdm.png`} alt="Centre for Product Design and Manufacturing" draggable="false" />
        </div>
        <div class="photo">
          {photoFile
            ? <img src={`${base}/${photoFile}`} alt="Portrait of Reetika Raj" draggable="false" />
            : <span class="ph"><b>RR</b><small>photo coming soon</small></span>}
        </div>
        <p class="name">Reetika<br /><span>Raj</span></p>
        <p class="role">Product Design, Development &amp; Management</p>
        <dl class="facts">
          <div><dt>Currently</dt><dd>M.Des Product Design, IISc</dd></div>
          <div><dt>Previously</dt><dd>Casilla Living · NIFT Delhi</dd></div>
        </dl>
      </div>
    </div>
  </div>
  <span class="hand hint" aria-hidden="true">
    <span class="hint-t">grab me &amp;<br />give it a swing</span>
    <svg class="hint-a" width="58" height="34" viewBox="0 0 58 34"><path d="M3 26 C 16 34, 36 30, 52 12 M52 12 L41 13 M52 12 L50 23" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
</div>

<script>
  type P = { x: number; y: number; px: number; py: number; w: number };
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-badge]").forEach((stage) => {
    const badge = stage.querySelector<HTMLElement>(".badge")!;
    const paths = [...stage.querySelectorAll<SVGPathElement>(".strap path")];
    const svg = stage.querySelector<SVGSVGElement>(".strap")!;
    const N = 10;
    let pts: P[] = [], seg = 0, ropeLen = 0, cardH = 0, cardW = 0, anchor = { x: 0, y: 0 };
    let drag: { t: number; x: number; y: number; id: number } | null = null;
    let running = false, visible = true, last = 0, acc = 0;
    // Drop-in: the strap's anchor starts far above the page and slides down after a delay;
    // the card follows on the physics, overshoots a little and settles.
    const REST_Y = -60, DELAY = 1000, DROP_MS = 650;
    let drop: { from: number; t0: number } | null = null;

    const hint = stage.querySelector<HTMLElement>(".hint");
    // Put the hint beside the card's resting position, arrow pointing at the card.
    const placeHint = () => {
      if (!hint) return;
      const top = anchor.y + ropeLen, w = hint.offsetWidth, gap = 10;
      let left = anchor.x - cardW / 2 - w - gap, right = false;
      if (left < 0) { left = anchor.x + cardW / 2 + gap; right = true; }
      hint.classList.toggle("on-right", right);
      hint.style.left = `${left}px`;
      hint.style.top = `${top + cardH * 0.5 - hint.offsetHeight / 2}px`;
    };
    const layout = () => {
      const r = stage.getBoundingClientRect();
      const narrow = r.width < 520;
      anchor = { x: r.width * (narrow ? 0.5 : 0.56), y: REST_Y };
      cardW = badge.offsetWidth; cardH = badge.offsetHeight;
      ropeLen = Math.max(120, r.height - cardH - 40 + 60);
      seg = ropeLen / N;
      pts = [];
      for (let i = 0; i <= N; i++) pts.push({ x: anchor.x, y: anchor.y + i * seg, px: anchor.x, py: anchor.y + i * seg, w: i === 0 ? 0 : 1 });
      const top = pts[N];
      pts.push({ x: top.x, y: top.y + cardH, px: top.x, py: top.y + cardH, w: 0.25 }); // card bottom (heavier)
      pts[N].w = 0.25; // card top shares the card's mass
      svg.setAttribute("viewBox", `0 ${anchor.y} ${r.width} ${r.height - anchor.y}`);
      svg.style.top = `${anchor.y}px`; svg.style.height = `${r.height - anchor.y}px`;
      render(0);
      placeHint();
    };

    const satisfy = (a: P, b: P, len: number) => {
      const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 0.0001;
      const diff = (d - len) / d, sw = a.w + b.w;
      if (!sw) return;
      a.x += dx * diff * (a.w / sw); a.y += dy * diff * (a.w / sw);
      b.x -= dx * diff * (b.w / sw); b.y -= dy * diff * (b.w / sw);
    };

    const step = (dt: number) => {
      const g = 2200 * dt * dt;
      for (let i = 1; i < pts.length; i++) {
        const p = pts[i];
        let vx = (p.x - p.px) * 0.988, vy = (p.y - p.py) * 0.988;
        const sp = Math.hypot(vx, vy); if (sp > 14) { vx *= 14 / sp; vy *= 14 / sp; }
        p.px = p.x; p.py = p.y; p.x += vx; p.y += vy + g;
      }
      const T = pts[N], B = pts[N + 1];
      if (drop) {
        const u = Math.min(1, (performance.now() - drop.t0) / DROP_MS), e = 1 - Math.pow(1 - u, 3);
        anchor.y = drop.from + (REST_Y - drop.from) * e;
        if (u >= 1) { drop = null; anchor.y = REST_Y; stage.classList.add("dropped"); }
      }
      for (let k = 0; k < 14; k++) {
        for (let i = 0; i < N; i++) satisfy(pts[i], pts[i + 1], seg);
        satisfy(T, B, cardH);
        pts[0].x = anchor.x; pts[0].y = anchor.y;
        if (drag) {
          const cx = T.x + (B.x - T.x) * drag.t, cy = T.y + (B.y - T.y) * drag.t;
          const ddx = drag.x - cx, ddy = drag.y - cy;
          T.x += ddx; T.y += ddy; B.x += ddx; B.y += ddy;
          // the strap can't stretch: keep the card top within rope length of the anchor
          const ax = T.x - anchor.x, ay = T.y - anchor.y, ad = Math.hypot(ax, ay), max = ropeLen * 0.98;
          if (ad > max) { const k = max / ad, nx = anchor.x + ax * k - T.x, ny = anchor.y + ay * k - T.y; T.x += nx; T.y += ny; B.x += nx; B.y += ny; }
        }
      }
    };

    const render = (vx: number) => {
      const T = pts[N], B = pts[N + 1];
      const ang = -Math.atan2(B.x - T.x, B.y - T.y) * 180 / Math.PI;
      const tilt = Math.max(-28, Math.min(28, vx * 2.2));
      badge.style.transform = `translate3d(${T.x - cardW / 2}px, ${T.y}px, 0) rotate(${ang}deg) rotateY(${tilt}deg)`;
      let d = `M ${pts[0].x} ${pts[0].y}`;
      for (let i = 1; i < N; i++) {
        const mx = (pts[i].x + pts[i + 1].x) / 2, my = (pts[i].y + pts[i + 1].y) / 2;
        d += ` Q ${pts[i].x} ${pts[i].y} ${mx} ${my}`;
      }
      d += ` L ${T.x} ${T.y + 6}`;
      paths.forEach((p) => p.setAttribute("d", d));
    };

    const frame = (t: number) => {
      if (!running) return;
      const dt = Math.min(0.05, (t - (last || t)) / 1000); last = t; acc += dt;
      while (acc >= 1 / 120) { step(1 / 120); acc -= 1 / 120; }
      const B = pts[N + 1];
      render(B.x - B.px);
      requestAnimationFrame(frame);
    };
    const start = () => { if (!running && visible && !reduce) { running = true; last = 0; requestAnimationFrame(frame); } };
    const stop = () => { running = false; };

    const local = (e: PointerEvent) => { const r = stage.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
    badge.addEventListener("pointerdown", (e) => {
      if (reduce) return;
      const p = local(e), T = pts[N], B = pts[N + 1];
      const vx = B.x - T.x, vy = B.y - T.y;
      const t = Math.max(0, Math.min(1, ((p.x - T.x) * vx + (p.y - T.y) * vy) / (vx * vx + vy * vy)));
      drag = { t, ...p, id: e.pointerId };
      badge.setPointerCapture(e.pointerId); badge.classList.add("grabbing");
      stage.classList.add("touched"); start(); e.preventDefault();
    });
    badge.addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const p = local(e), r = stage.getBoundingClientRect();
      drag.x = Math.max(-40, Math.min(r.width + 40, p.x)); drag.y = Math.max(0, Math.min(r.height + 120, p.y));
    });
    const end = (e: PointerEvent) => { if (drag && e.pointerId === drag.id) { drag = null; badge.classList.remove("grabbing"); } };
    badge.addEventListener("pointerup", end); badge.addEventListener("pointercancel", end);

    new IntersectionObserver(([en]) => { visible = en.isIntersecting; if (!visible) stop(); else if (!drop && stage.classList.contains("dropped")) start(); }).observe(stage);
    let rt = 0; addEventListener("resize", () => { clearTimeout(rt); rt = window.setTimeout(() => { drop = null; layout(); stage.classList.add("dropped"); }, 120); });
    layout();
    if (reduce) { stage.classList.add("dropped"); }
    else {
      // park everything above the page, then let it fall in after DELAY
      const lift = ropeLen + cardH + 140;
      pts.forEach((p) => { p.y -= lift; p.py -= lift; });
      anchor.y = REST_Y - lift; render(0);
      setTimeout(() => {
        drop = { from: anchor.y, t0: performance.now() };
        pts[N + 1].px -= 6; pts[N].px -= 3; // a slight sideways swing as it lands
        start();
      }, DELAY);
    }
  });
</script>

<style>
  .stage { position: relative; height: 100%; min-height: 560px; perspective: 1200px; }
  .strap { position: absolute; left: 0; width: 100%; overflow: visible; pointer-events: none; }
  .strap path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .s-edge { stroke: #5546AD; stroke-width: 17; opacity: .45; }
  .s-fill { stroke: #B3A8EC; stroke-width: 14; }
  /* multicolour lanyard: five colour blocks repeating along the strap */
  .s-band { stroke-width: 14; stroke-linecap: butt !important; stroke-dasharray: 22 88; }
  .b1 { stroke: #B3A8EC; } .b2 { stroke: #F0BCCB; stroke-dashoffset: -22; } .b3 { stroke: #F4E4A6; stroke-dashoffset: -44; }
  .b4 { stroke: #B3DCC8; stroke-dashoffset: -66; } .b5 { stroke: #AFD5E8; stroke-dashoffset: -88; }
  .s-dash { stroke: #fff; stroke-width: 1.5; stroke-dasharray: 3 7; opacity: .7; }

  .badge { position: absolute; left: 0; top: 0; width: 264px; transform-origin: 50% 0; cursor: url("/cursor-link.svg") 4 4, grab; touch-action: none; user-select: none; -webkit-user-select: none; will-change: transform; filter: drop-shadow(0 18px 22px rgba(60, 50, 100, .18)); }
  .badge.grabbing { cursor: url("/cursor-link.svg") 4 4, grabbing; }
  .clip { position: relative; height: 26px; display: grid; justify-items: center; }
  .clip span { width: 18px; height: 26px; border-radius: 6px 6px 3px 3px; background: linear-gradient(90deg, #b9b7c4, #f1f0f5 45%, #a8a5b6); border: 1px solid #8f8ba1; }
  .sleeve { margin-top: -4px; padding: 10px; border-radius: 18px; background: rgba(255, 255, 255, .55); border: 1px solid rgba(119, 113, 143, .35); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .7); backdrop-filter: blur(2px); }
  .slot { width: 46px; height: 7px; margin: 0 auto 8px; border-radius: 99px; background: var(--bg); border: 1px solid rgba(119, 113, 143, .35); }
  .card { background: var(--surface); border-radius: 12px; padding: 14px 16px 12px; border: 1px solid var(--line); }
  .card-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; height: 56px; }
  .card-top img { height: 100%; width: auto; pointer-events: none; }
  .card-top .logo-cpdm { height: 42px; }
  .photo { margin: 12px auto 10px; aspect-ratio: 1 / 1; width: 96px; border-radius: 14px; overflow: hidden; background: var(--lav-tint); }
  .photo img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .ph { display: grid; place-items: center; align-content: center; height: 100%; border: 1.5px dashed var(--lav); border-radius: 14px; text-align: center; color: var(--lav-ink); }
  .ph b { font: 800 1.6rem var(--f-head); line-height: 1; }
  .ph small { font-size: .58rem; font-weight: 700; margin-top: 4px; }
  .name { margin: 0; font: 800 2rem/0.95 var(--f-head); letter-spacing: -0.02em; color: var(--ink); }
  .name span { color: inherit; }
  .role { margin: 8px 0 10px; font-size: .82rem; font-weight: 700; color: var(--ink); }
  .facts { margin: 0; display: grid; gap: 6px; font-size: .74rem; line-height: 1.3; }
  .facts dt { font-style: italic; color: var(--muted); font-size: .68rem; }
  .facts dd { margin: 0; font-weight: 700; }
  .hint { position: absolute; left: 0; top: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; text-align: right; line-height: 1.15; color: var(--lav-ink); transition: opacity .4s; pointer-events: none; }
  .hint-a { margin-right: -6px; }
  .hint.on-right { align-items: flex-start; text-align: left; }
  .hint.on-right .hint-a { transform: scaleX(-1); margin: 0 0 0 -6px; }
  .stage:not(.dropped) .hint { opacity: 0; }
  .stage.dropped .hint { transition-delay: .3s; }
  .stage.touched .hint { opacity: 0; transition-delay: 0s; }
  @media (max-width: 520px) { .badge { width: 220px; } .name { font-size: 1.75rem; } .hint { display: none; } }
  @media (prefers-reduced-motion: reduce) { .badge { cursor: url("/cursor.svg") 4 4, default; } .hint { display: none; } }
</style>
