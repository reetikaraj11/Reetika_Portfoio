---
/* Tabbed photo switcher (ARIA tabs with arrow-key support). */
interface Item { label: string; img: string; alt: string; title: string; text: string; tags?: string[]; }
interface Props { items: Item[]; }
const { items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const uid = `pt${Math.random().toString(36).slice(2, 7)}`;
---
<div class="pt" data-pt>
  <div class="pt-tabs" role="tablist" aria-label="Posture trials">
    {items.map((it, i) => (
      <button type="button" role="tab" id={`${uid}-t${i}`} aria-controls={`${uid}-p${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{it.label}</button>
    ))}
  </div>
  {items.map((it, i) => (
    <div class="pt-panel" role="tabpanel" id={`${uid}-p${i}`} aria-labelledby={`${uid}-t${i}`} hidden={i !== 0}>
      <div class="pt-img"><img src={`${base}${it.img}`} alt={it.alt} loading={i === 0 ? "lazy" : "lazy"} decoding="async" /></div>
      <div class="pt-text">
        <span class="pt-k">{String(i + 1).padStart(2, "0")} / {String(items.length).padStart(2, "0")}</span>
        <h3>{it.title}</h3>
        <p>{it.text}</p>
        {it.tags && <div class="pt-tags">{it.tags.map((t) => <span class="chip">{t}</span>)}</div>}
      </div>
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-pt]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (i: number, focus = false) => tabs.forEach((t, k) => {
      const on = k === i;
      t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1;
      (root.querySelector(`#${t.getAttribute("aria-controls")}`) as HTMLElement).hidden = !on;
      if (on && focus) t.focus();
    });
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") select((i + 1) % tabs.length, true);
        if (e.key === "ArrowLeft") select((i - 1 + tabs.length) % tabs.length, true);
      });
    });
  });
</script>
<style>
  .pt-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .pt-tabs button { padding: 9px 16px; border-radius: 999px; border: 1.5px solid var(--edge); background: var(--surface); color: var(--ink); font: 700 .92rem var(--f-body); cursor: url("/cursor-link.svg") 4 4, pointer; }
  .pt-tabs button[aria-selected="true"] { background: var(--accent); }
  .pt-panel { display: grid; gap: 24px; align-items: center; }
  .pt-panel[hidden] { display: none; }
  @media (min-width: 820px) { .pt-panel { grid-template-columns: minmax(260px, 380px) 1fr; } }
  .pt-img { border-radius: var(--radius); overflow: hidden; border: 1.5px solid var(--edge); aspect-ratio: 3 / 4; background: var(--surface); max-width: 380px; width: 100%; }
  .pt-img img { width: 100%; height: 100%; object-fit: cover; animation: pt-in .4s ease; }
  @keyframes pt-in { from { opacity: 0; transform: scale(1.02); } to { opacity: 1; transform: none; } }
  .pt-k { font: 800 .78rem var(--f-head); letter-spacing: .1em; color: var(--accent-ink); }
  .pt-text h3 { font-size: clamp(1.4rem, 2.6vw, 2rem); margin: 6px 0 10px; }
  .pt-text p { color: var(--muted); max-width: 32em; }
  .pt-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (prefers-reduced-motion: reduce) { .pt-img img { animation: none; } }
</style>
