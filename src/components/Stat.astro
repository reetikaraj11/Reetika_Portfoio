---
interface Props { num: string; label: string; tone?: "lav" | "sky" | "pink" | "lemon" | "mint"; }
const { num, label, tone = "lav" } = Astro.props;
---
<div class:list={["stat", `tone-${tone}`]}>
  <div class="num" set:html={num} />
  <p set:html={label} />
</div>
<style>
  .stat { border-radius: var(--radius); padding: 22px 22px 20px; }
  .num { font: 800 clamp(2rem, 3.6vw, 2.7rem)/1 var(--f-head); letter-spacing: -0.02em; margin-bottom: 10px; }
  p { margin: 0; color: var(--muted); font-size: .95rem; line-height: 1.45; }
</style>
